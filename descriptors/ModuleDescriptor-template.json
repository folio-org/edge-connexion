{
  "id": "${artifactId}-${version}",
  "name": "edge-connexion",
  "provides": [
    {
      "id": "connexion",
      "version": "1.0"
    }
  ],
  "requires" : [
    {
      "id" : "login",
      "version" : "7.0"
    },
    {
      "id" : "copycat-imports",
      "version" : "1.0"
    },
    {
      "id" : "copycat-profiles",
      "version" : "1.0"
    }
  ],
  "permissionSets" : [ ],
  "launchDescriptor": {
    "dockerImage": "${artifactId}:${version}",
    "dockerPull": false,
    "dockerArgs": {
      "HostConfig": {
        "Memory": 35913941,
        "PortBindings": { "8081/tcp": [ { "HostPort": "%p" } ] }
      }
    },
    "env": [
      { "name": "JAVA_OPTIONS",
        "value": "-XX:MaxRAMPercentage=66.0"
      }
    ]
  }

}
